        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Because training builds upon the same basic judgment. It may help
          some people form stronger arguments, but it does not make everyone else
          unable to evaluate them.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 4
      isRoot: 0
      isGroup: 0
