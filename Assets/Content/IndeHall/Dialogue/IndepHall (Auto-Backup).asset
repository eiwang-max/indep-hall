        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "A man in a funny hat who called himself a \"ranger\" handed me an
          empty card. Printed on it was the same sun as the one on the back of General
          Washington\u2019s chair."
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
