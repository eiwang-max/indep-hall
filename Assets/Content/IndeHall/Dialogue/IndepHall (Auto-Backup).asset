        value: Why should the most consequential choice in the republic be entrusted
          to citizens who, for the most part, have little experience in public affairs?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 4
      isRoot: 0
      isGroup: 0
