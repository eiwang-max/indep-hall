        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: The small states are asking for extra power because they have fewer
          people. Why should the country accept that?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
