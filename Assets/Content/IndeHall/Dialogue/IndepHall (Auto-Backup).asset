        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: What are you going to do now?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 3
      isRoot: 0
