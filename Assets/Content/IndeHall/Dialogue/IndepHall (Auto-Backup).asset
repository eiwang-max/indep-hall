        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: You speak as though citizens judge alone. In a national election,
          fear and excitement spread through the public.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      conversationID: 4
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
