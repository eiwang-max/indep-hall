        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I hope you do. Right now, you\u2019re standing in the same position
          that I was in. Is compromise your next thought as well?"
