        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I wrote my own message on the card: \u201CRestore me to my proper
          place before the Convention decides how the Executive shall be chosen.\u201D
          Then the card burned away and disappeared."
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
