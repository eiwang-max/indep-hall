        height: 30
    - id: 77
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 4
        type: 5
        typeString: CustomFieldType_Actor
