        width: 160
        height: 30
    - id: 62
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 6
        type: 5
        typeString: CustomFieldType_Actor
