        originDialogueID: 24
        destinationConversationID: 5
        destinationDialogueID: 25
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 589.82654
