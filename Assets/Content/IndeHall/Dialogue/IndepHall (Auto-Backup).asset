        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: People should vote as Americans, not only as Virginians or New Yorkers.
          The President governs people, not states.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
