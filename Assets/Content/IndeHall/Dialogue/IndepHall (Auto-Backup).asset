        isConnector: 0
        priority: 2
      - originConversationID: 5
        originDialogueID: 25
        destinationConversationID: 5
        destinationDialogueID: 27
        isConnector: 0
        priority: 2
      - originConversationID: 5
        originDialogueID: 25
        destinationConversationID: 5
        destinationDialogueID: 28
        isConnector: 0
        priority: 2
      - originConversationID: 5
        originDialogueID: 25
        destinationConversationID: 5
        destinationDialogueID: 29
        isConnector: 0
        priority: 2
